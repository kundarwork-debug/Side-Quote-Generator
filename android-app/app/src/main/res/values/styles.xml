<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.APML" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/apml_accent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@color/apml_system_surface</item>
        <item name="android:navigationBarColor">@color/apml_system_surface</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/apml_splash_background</item>
    </style>

    <style name="Theme.APML.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/apml_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
        <item name="windowSplashScreenAnimationDuration">350</item>
        <item name="postSplashScreenTheme">@style/Theme.APML</item>
    </style>
</resources>
